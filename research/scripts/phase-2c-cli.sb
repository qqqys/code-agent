(version 1)

(deny default)
(import "system.sb")

(allow process-info* (target self))
(allow process-fork)
(allow process-exec
  (literal (param "TARGET_BINARY")))
(allow signal (target self))

(allow file-read-metadata file-test-existence
  (literal "/")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/opt")
  (literal "/opt/homebrew")
  (literal "/opt/homebrew/Cellar")
  (literal "/opt/homebrew/opt")
  (path-ancestors (param "TARGET_BINARY"))
  (path-ancestors (param "TARGET_ROOT"))
  (path-ancestors (param "PROBE_ROOT"))
  (path-ancestors (param "WRITE_ROOT"))
  (path-ancestors "/opt/homebrew/Cellar/node/25.9.0_2/lib/libnode.141.dylib")
