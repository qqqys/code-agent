(version 1)

(deny default)
(import "system.sb")

; The probe runner and qwen child share this sandbox.  Qwen is JavaScript, so
; the only executable is the exact pinned Node runtime.
(allow process-info* (target self))
(allow process-info-pidinfo (target children))
(allow process-fork)
(allow process-exec
  (literal (param "NODE_LINK"))
  (literal (param "NODE_REAL")))
(allow signal (target self))
(allow signal (target children))

(allow file-read-metadata file-test-existence
  (literal "/")
  (literal "/private")
  (literal "/private/tmp")
  (literal "/private/tmp/ccq-phase1b-qwen-0.21.0")
  (literal "/private/tmp/ccq-phase1b-qwen-0.21.0/package")
  (literal "/opt")
  (literal "/opt/homebrew")
  (literal "/Users")
  (literal "/Users/qqqys")
  (literal "/Users/qqqys/Desktop")
  (literal "/Users/qqqys/Desktop/qys")
  (literal "/Users/qqqys/Desktop/qys/qwen-code")
  (literal "/Users/qqqys/Desktop/qys/qwen-code/.qwen")
  (literal "/Users/qqqys/Desktop/qys/qwen-code/.qwen/research")
  (literal "/Users/qqqys/Desktop/qys/qwen-code/.qwen/research/codex-claude-qwen")
  (literal "/Users/qqqys/Desktop/qys/qwen-code/.qwen/research/codex-claude-qwen/scripts"))

(allow file-read* file-test-existence
  (subpath "/opt/homebrew")
  (literal (param "RUNNER"))
  (subpath (param "QWEN_PACKAGE"))
  (subpath (param "PROBE_ROOT")))

(allow file-map-executable
  (subpath "/opt/homebrew"))

(allow file-write*
  (subpath (param "PROBE_ROOT")))

; The daemon may bind and the fixture client may connect only over loopback.
(allow network* (local ip))
(allow network-outbound (remote ip "localhost:*"))
